# Refugehomes Ltd - Apache / LiteSpeed config for Hostinger
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS: switch on "Force HTTPS" in Hostinger hPanel > Security > SSL.

  # Block direct access to code, content and private data
  RewriteRule ^(includes|content|private)(/|$) - [F,L]

  # Clean URLs: /about -> about.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]

  # Old-style links: /about.php -> /about
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)([a-z0-9-]+)\.php[\s?] [NC]
  RewriteCond %2 !^(index|router)$
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteRule ^ /%1%2 [R=301,L,NE]
</IfModule>

<FilesMatch "\.(json|md|log|tmp)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

ErrorDocument 404 /404.php
